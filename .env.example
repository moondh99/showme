# Copy to .env.local and fill in locally. Keep the API key on the server.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Confirm this model is available to the account during the first real call.
META_VISION_MODEL=muse-spark-1.3

# Optional. If empty, the local app generates state/author-password.txt on first run.
SHOWME_AUTHOR_PASSWORD=
