state/

# Raw experiment inputs and responses stay local by default
experiments/meta-vision/inputs/*
!experiments/meta-vision/inputs/.gitkeep
experiments/meta-vision/results/*
!experiments/meta-vision/results/.gitkeep

# Local design-review snapshots can include workstation paths.
.impeccable/
